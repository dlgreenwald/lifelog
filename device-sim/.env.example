# OIDC provider (same provider your server uses)
DEVICE_SIM_OIDC_ISSUER=https://auth.dlgreen.com/application/o/life-logger/

# OAuth client ID (must have Resource Owner Password Credentials grant enabled)
DEVICE_SIM_CLIENT_ID=your-client-id-here

# Test user account credentials (password grant — interaction-free)
DEVICE_SIM_USERNAME=testUser
DEVICE_SIM_PASSWORD=your-password-here

# OIDC sub for the test user — must match the user row in the DB
DEVICE_SIM_TEST_OIDC_SUB=simulator-device-001

# Lifelog server
DEVICE_SIM_SERVER_URL=http://localhost:8444

# AMI meeting to replay
MEETING_ID=EN2001a

# Slicing controls (0 = disabled)
MAX_UTTERANCES=0
SILENCE_INSERT_EVERY=0
SILENCE_INSERT_PROBABILITY=0.5
