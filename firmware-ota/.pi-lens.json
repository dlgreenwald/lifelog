{
  "ignore": [
    ".pio/**",
    "test/**"
  ],
  "rules": {
    "cpp-check": { "disable": ["cpp-check"] }
  },
  "serverOverrides": {
    "clangd": {
      "initializationOptions": {
        "clangd.semanticHighlighting": true,
        "clangd.diagnosticsDelay": 60000
      }
    }
  },
  "warmFiles": [
    "src/main.cpp"
  ]
}
