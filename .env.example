# ============================================
# LifeLog — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Required variables are marked with [REQUIRED].
# Optional variables show their defaults in brackets.

# ---------- Database ----------
# [REQUIRED] PostgreSQL password
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ---------- LLM (OpenAI-compatible endpoint) ----------
# [REQUIRED] Point to your local LLM server (Ollama, llama.cpp, vLLM, etc.)
#
# Since docker-compose runs on this machine, use host.docker.internal
# to reach services on the host:
#   Ollama:     http://host.docker.internal:11434/v1
#   llama.cpp:  http://host.docker.internal:8080/v1
#   vLLM:       http://host.docker.internal:8000/v1
OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# [Optional] API key — Ollama ignores this; llama.cpp may need "none"
# OPENAI_API_KEY=ollama

# [Optional] Model name — must match what's pulled/running on your LLM server
# Ollama:    run `ollama list` to see available models
# llama.cpp: set via --model flag when starting the server
OPENAI_MODEL=llama3

# ---------- Whisper ASR (transcription + diarization) ----------
# Runs in Docker with GPU. Uses internal DNS — no config needed unless
# you want to override the defaults.
# WHISPER_ASR_URL=http://whisper-asr:9000

# [REQUIRED on first run] HuggingFace token for pyannote diarization model
# Get one at https://huggingface.co/settings/tokens
# You must also accept the pyannote model terms at:
# https://huggingface.co/pyannote/speaker-diarization-3.1
# After first run the model is cached and this can be removed.
HF_TOKEN=hf_your-huggingface-token-here

# ---------- OIDC (OpenID Connect) ----------
# [REQUIRED] OIDC provider configuration for dashboard login
# Works with Keycloak, Auth0, Authelia, or any OIDC-compliant provider
OIDC_ISSUER_URL=https://your-oidc-provider.example.com
OIDC_CLIENT_ID=lifelog-dashboard
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_REDIRECT_URI=http://localhost:3000
