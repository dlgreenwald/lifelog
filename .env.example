# ============================================
# LifeLog — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Required variables are marked with [REQUIRED].
# Optional variables show their defaults in brackets.

# ---------- Database ----------
# [REQUIRED] PostgreSQL password — must match POSTGRES_PASSWORD in docker-compose
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ---------- LLM (OpenAI-compatible endpoint) ----------
# [REQUIRED] Point to your local LLM server (Ollama, llama.cpp, vLLM, etc.)
#
# Ollama:     http://192.168.1.50:11434/v1
# llama.cpp:  http://192.168.1.50:8080/v1
# vLLM:       http://192.168.1.50:8000/v1
#
# When running inside docker-compose, use host.docker.internal to reach
# the host machine: http://host.docker.internal:11434/v1
OPENAI_BASE_URL=http://192.168.1.50:11434/v1

# [Optional] API key — Ollama ignores this, llama.cpp may need "none"
# OPENAI_API_KEY=ollama

# [Optional] Model name — must match what's pulled/running on your LLM server
# Ollama:    run `ollama list` to see available models
# llama.cpp: set via --model flag when starting the server
OPENAI_MODEL=llama3

# ---------- Wyoming Whisper STT (runs on dedicated GPU machine) ----------
# [REQUIRED] Point to your wyoming-faster-whisper instance
# Start it separately on your GPU machine:
#   docker run --gpus all rhasspy/wyoming-faster-whisper:latest \
#     --model large-v3 --language en --dtype float16 --listen 0.0.0.0:10700
WYOMING_HOST=192.168.1.50
WYOMING_PORT=10700

# ---------- Diarization (runs on dedicated GPU machine) ----------
# [REQUIRED] Point to your pyannote diarization service
# Start it separately on your GPU machine — see docker-compose.yml for
# the full docker run command, or copy the diarization/ directory and
# run: docker-compose up diarization
#
# The diarization service needs HF_TOKEN to download the pyannote model
# on first run. After that it caches the model and HF_TOKEN is no longer
# needed at runtime.
DIARIZATION_URL=https://192.168.1.50:8443

# [Optional] HuggingFace token — only needed on first run to download model
# Get one at https://huggingface.co/settings/tokens
# You must also accept the pyannote model terms at:
# https://huggingface.co/pyannote/speaker-diarization-3.1
# HF_TOKEN=hf_your-huggingface-token-here

# ---------- OIDC (OpenID Connect) ----------
# [REQUIRED] OIDC provider configuration for dashboard login
# Works with Keycloak, Auth0, Authelia, or any OIDC-compliant provider
OIDC_ISSUER_URL=https://your-oidc-provider.example.com
OIDC_CLIENT_ID=lifelog-dashboard
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_REDIRECT_URI=https://localhost:3000

# ---------- Service URLs (optional overrides) ----------
# These have sensible defaults for docker-compose but can be overridden
# if services run on different hosts/ports.
#
# SPEAKER_ID_URL=https://speaker-id:8443
