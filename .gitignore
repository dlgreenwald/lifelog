# ============================================
# LifeLog — .gitignore
# ============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# mypy / ruff
.mypy_cache/
.ruff_cache/

# ---------- Node / TypeScript ----------
node_modules/
dist/
*.tsbuildinfo
*.tsbuildinfo.tmp

# ---------- IDE / Editor ----------
# VS Code workspace (user-specific)
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
*~
Session.vim
.netrwhist

# Emacs
\#*\#
.#*
*.elc

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example

# ---------- TLS Certificates ----------
# Private keys (NEVER commit)
*.key
*.pem
*.p12
*.pfx
*.jks

# CSRs and CA serial files
*.csr
ca.srl

# Certificate directories (generated by scripts/generate-certs.sh)
server/certs/
diarization/certs/
speaker-id/certs/

# CA root (generated)
ca.key
ca.crt

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- Docker ----------
# Docker volumes mounted at runtime
postgres-data/
audio-data/
whisper-asr/models/
whisper-asr/hf-cache/

# ---------- E2E ----------
e2e/voices/

# ---------- PlatformIO / Firmware ----------
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# ---------- Logs ----------
*.log
logs/

# ---------- Build artifacts ----------
# Audio files (generated, not source)
*.opus
*.wav
*.mp3

# ML model weights (large, not source)
*.onnx

# Encrypted audio (runtime data)
*.enc

# Compiled firmware / native binaries (never source)
*.bin
*.elf

# Database files
*.sqlite
*.sqlite3
*.db
*.db3

# Compile Commands
firmware-ota/compile_commands.json

# ---------- Misc ----------
tmp/
temp/
*.bak
*.tmp
*.orig

# Alembic config (contains DB credentials)
alembic.ini
