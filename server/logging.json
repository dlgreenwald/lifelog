{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "default": {
            "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s",
            "datefmt": "%Y-%m-%d %H:%M:%S"
        }
    },
    "handlers": {
        "default": {
            "formatter": "default",
            "class": "logging.StreamHandler",
            "stream": "ext://sys.stdout"
        }
    },
    "loggers": {
        "lifelog": {
            "handlers": ["default"],
            "level": "INFO",
            "propagate": false
        },
        "httpcore": {
            "handlers": ["default"],
            "level": 15,
            "propagate": false
        },
        "httpx": {
            "handlers": ["default"],
            "level": 15,
            "propagate": false
        },
        "uvicorn": {
            "handlers": ["default"],
            "level": "INFO",
            "propagate": false
        },
        "uvicorn.error": {
            "handlers": ["default"],
            "level": "INFO",
            "propagate": false
        },
        "uvicorn.access": {
            "handlers": ["default"],
            "level": "INFO",
            "propagate": false
        }
    },
    "root": {
        "handlers": ["default"],
        "level": "INFO"
    }
}
